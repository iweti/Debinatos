{
  "name": "debinatos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src next.config.ts postcss.config.mjs tsconfig.json vitest.config.ts"
  },
  "dependencies": {
    "@neon/config": "1.8.6",
    "@neon/env": "1.5.3",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@htmlacademy/eslint-plugin-jsx-a11y": "6.11.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "autoprefixer": "10.6.1",
    "eslint": "10.13.0",
    "eslint-plugin-better-tailwindcss": "4.9.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fake-indexeddb": "6.2.5",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11 <12",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
