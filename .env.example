# Conexão da aplicação com a branch correspondente (preferencialmente com pool).
DATABASE_URL=
# Opcional no runtime: conexão direta, sem -pooler, para aplicar migrações SQL.
# MIGRATION_DATABASE_URL tem preferência; DATABASE_URL_UNPOOLED é a alternativa.
MIGRATION_DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Opcional no runtime: destino direto de uma branch temporária separada.
# Usado somente por scripts/validate-highlights.mjs, com DATABASE_URL como origem.
VALIDATION_DATABASE_URL=

# Segredo aleatório do servidor, com pelo menos 32 bytes. Nunca use NEXT_PUBLIC_.
SESSION_SECRET=

# Cloudinary: credenciais do servidor; o navegador recebe somente autorização de upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: vazio usa a pasta debinatos.
CLOUDINARY_FOLDER=

# WhatsApp opcional: código do país + DDD + número, 12–13 dígitos.
# Exemplo de formato: 5511999999999. Deixe vazio até configurar o número da loja.
WHATSAPP_PHONE=
