# Conexão da aplicação com a branch correspondente (preferencialmente com pool).
DATABASE_URL=
# Conexão direta, sem -pooler, usada para aplicar migrações SQL.
DATABASE_URL_UNPOOLED=

# Segredo aleatório do servidor, com pelo menos 32 bytes. Nunca use NEXT_PUBLIC_.
SESSION_SECRET=

# Cloudinary: credenciais do servidor; o navegador recebe somente autorização de upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=debinatos

# WhatsApp: código do país + DDD + número, apenas dígitos.
# Exemplo de formato: 5511999999999. Deixe vazio até configurar o número da loja.
WHATSAPP_PHONE=
